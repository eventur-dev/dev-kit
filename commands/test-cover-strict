#!/usr/bin/env bash
set -euo pipefail

if [[ ! -d tests ]] || \
   ! find tests -type f \( -name "*Test.php" -o -name "*.phpt" \) | grep -q .; then
    echo "No tests found. Skipping strict coverage."
    exit 0
fi

coverage_report="$(mktemp)"
trap 'rm -f "$coverage_report"' EXIT

XDEBUG_MODE=coverage \
php -d memory_limit=-1 \
    vendor/bin/phpunit \
    --testdox \
    --colors=never \
    --coverage-text \
    --display-deprecations \
    --fail-on-incomplete \
    --fail-on-risky \
    --fail-on-skipped \
    --fail-on-all-issues \
| tee "$coverage_report"

awk '
    /^ Summary:$/ {
        in_summary = 1
        next
    }

    in_summary && /^[[:space:]]+(Classes|Methods|Lines):/ {
        metric = $1
        value = $2
        sub(/:$/, "", metric)

        seen[metric] = 1

        if (value != "100.00%" && value != "(0/0)") {
            incomplete[metric] = value
        }
    }

    END {
        metrics[1] = "Classes"
        metrics[2] = "Methods"
        metrics[3] = "Lines"
        failed = 0

        for (position = 1; position <= 3; position++) {
            metric = metrics[position]

            if (!(metric in seen)) {
                printf "Missing %s coverage summary.\n", metric
                failed = 1
            } else if (metric in incomplete) {
                printf "%s coverage is %s.\n", metric, incomplete[metric]
                failed = 1
            }
        }

        exit failed
    }
' "$coverage_report" || {
    printf '\n\033[0;31m❌ Class, method, and line coverage must all be 100%%.\033[0m\n\n'
    exit 1
}
